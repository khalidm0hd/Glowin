  id: string;
  name: string;
  brand: string;
  category: string;
  subcategory: string;
  price: number;
  size: string;
  unit?: string;
  description: string;
  benefits: string[];
  howToApply: string;
  ingredients?: string;
  images: string[];
  availability: 'in_stock' | 'pre_order' | 'out_of_stock';
  searchKeywords: string[];
}

